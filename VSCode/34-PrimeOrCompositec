#include<stdio.h>
int main()
{   /*composite number:divisible by number other than 1 and itself.
    prime number    :divisible by 1 and itself.*/
    int n;
    printf("enter an number:");
    scanf("%d",&n);
    int a=0;
    for(int i=2;i<=n-1;i++)    // 2 to n-1
    {
        if(n%i==0)   
       {
           a=1;
           break;
       }
    }
     if(n==1)
     {
        printf("1 is neither prime nor composite\n");
    }
     else if(a==0)
     {
         printf("the given number is prime\n");
     }
     else{
        printf("the given number is composite\n");
     }
    }